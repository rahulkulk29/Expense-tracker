{
  "info": {
    "name": "Expense Tracker API",
    "description": "Postman collection for testing the Expense Tracker FastAPI backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "expenseId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Status is healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create Valid Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('Expense created with ID', function () { pm.expect(json.id).to.be.a('number'); });",
              "pm.collectionVariables.set('expenseId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500.00,\n  \"category\": \"Food\",\n  \"description\": \"Lunch\",\n  \"expense_date\": \"2026-11-26\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/expenses"
      }
    },
    {
      "name": "Create Invalid Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": -10.00,\n  \"category\": \"InvalidCategory\",\n  \"description\": \"Bad request\",\n  \"expense_date\": \"2026-11-26\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/expenses"
      }
    },
    {
      "name": "Get All Expenses",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses"
      }
    },
    {
      "name": "Get Expenses Filtered by Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('All items match Food category', function () {",
              "  pm.response.json().forEach(item => pm.expect(item.category).to.eql('Food'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses?category=Food"
      }
    },
    {
      "name": "Get Expenses Filtered by Date Range",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses?start_date=2026-11-01&end_date=2026-11-30"
      }
    },
    {
      "name": "Get Expense by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has expected ID', function () { pm.expect(pm.response.json().id).to.be.a('number'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}"
      }
    },
    {
      "name": "Get Nonexistent Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Detail message matches', function () { pm.expect(pm.response.json().detail).to.eql('Expense not found'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses/99999"
      }
    },
    {
      "name": "Update Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Amount updated', function () { pm.expect(pm.response.json().amount).to.eql(600); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 600.00,\n  \"category\": \"Food\",\n  \"description\": \"Dinner\",\n  \"expense_date\": \"2026-11-26\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}"
      }
    },
    {
      "name": "Update Nonexistent Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 600.00,\n  \"category\": \"Food\",\n  \"description\": \"Dinner\",\n  \"expense_date\": \"2026-11-26\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/expenses/99999"
      }
    },
    {
      "name": "Expense Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Summary has required fields', function () {",
              "  pm.expect(json).to.have.property('total_expenses');",
              "  pm.expect(json).to.have.property('expense_count');",
              "  pm.expect(json).to.have.property('category_summary');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses/summary"
      }
    },
    {
      "name": "Invalid Date Range",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/expenses?start_date=2026-11-30&end_date=2026-11-01"
      }
    },
    {
      "name": "Delete Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}"
      }
    },
    {
      "name": "Delete Nonexistent Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/expenses/99999"
      }
    }
  ]
}

